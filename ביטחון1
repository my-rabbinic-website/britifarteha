        }
        ::-webkit-scrollbar-thumb:hover {
            background-color: #b0813f; 
        }

        /* Reading Progress Bar */
        #scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 4px;
            background: linear-gradient(to right, #dfb36b, #b0813f, #8c6622);
            z-index: 1000;
            transition: width 0.1s ease-out;
            box-shadow: 0 0 10px rgba(223, 179, 107, 0.7);
        }

        /* Hero Background with Sun Effect */
        .hero-bg {
            background: radial-gradient(circle at top right, #fffaf0 0%, #faedd4 30%, #e3bd7f 70%, #cc9c52 100%);
            position: relative;
            overflow: hidden;
        }
        
        .hero-bg::before {
            content: "";
            position: absolute;
            top: -15vw;
            right: -15vw;
            width: 50vw;
            height: 50vw;
            min-width: 400px;
            min-height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,1) 0%, rgba(255,255,255,0.7) 20%, rgba(253,248,240,0) 70%);
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
            animation: pulse 8s infinite alternate ease-in-out;
        }

        /* Text Gradients */
        .text-gradient-brown {
            background: linear-gradient(135deg, #5c4018 0%, #261806 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .text-gradient-gold {
            background: linear-gradient(to right, #c09440, #dfb36b, #b0813f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.8) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 25px 50px -12px rgba(92, 64, 24, 0.15), inset 0 1px 0 rgba(255, 255, 255, 1);
        }

        /* Reveal Animation on Scroll */
        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: all 1.2s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Image Display Styling */
        .book-image-container {
            position: relative;
            z-index: 10;
        }
        
        .book-image-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 90%;
            height: 90%;
            background: radial-gradient(circle, rgba(255,255,255,0.8) 0%, rgba(223,179,107,0.4) 50%, transparent 80%);
            filter: blur(40px);
            z-index: -1;
            border-radius: 50%;
        }

        /* FAQ Accordion Transitions */
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s ease-out, padding 0.5s ease, opacity 0.3s ease;
            opacity: 0;
        }
        .faq-item.active .faq-answer {
            max-height: 300px;
            padding-top: 1.25rem;
            padding-bottom: 1.25rem;
            opacity: 1;
        }
        .faq-item.active .faq-icon {
            transform: rotate(180deg);
            color: #b0813f;
        }
        
        /* Shimmer Effect for Buttons */
        .btn-shimmer {
            position: relative;
            overflow: hidden;
        }
        .btn-shimmer::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(to right, transparent, rgba(255,255,255,0.3), transparent);
            transform: skewX(-20deg);
            animation: shimmer 3s infinite;
        }

        /* Decorative patterns */
        .pattern-dots {
            background-image: radial-gradient(#dfb36b 1px, transparent 1px);
            background-size: 20px 20px;
        }
    </style>
</head>
